# Variables d'environnement — ExamSDK backend (01_BACKEND.md §14)
# Copier ce fichier en `.env` et remplacer les valeurs. Le `.env` n'est JAMAIS versionné.
# Aucune valeur ci-dessous n'est une vraie clé secrète : ce sont des exemples de développement.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-secret-key-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Origines autorisées pour les requêtes POST (obligatoire derrière HTTPS en prod).
# CSRF_TRUSTED_ORIGINS=https://dashboard.examsdk.example

# --- Base de données ---
# Vide = SQLite en développement (backend/db.sqlite3). En production :
# DATABASE_URL=mysql://user:password@host:3306/examsdk
DATABASE_URL=

# --- Redis (cache + broker Celery) ---
# Vide = cache mémoire + Celery en mode synchrone (dev sans Redis).
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=
# CELERY_TASK_ALWAYS_EAGER=True

# --- Chiffrement des clés secrètes au repos (01_BACKEND.md §12) ---
# Générer : .venv\Scripts\python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NE JAMAIS régénérer en production : les secret_key existantes deviendraient illisibles.
FIELD_ENCRYPTION_KEY=DhDMRVEz_RNRKmxcUEc_7Ha36fRTVtiMlCRAKlPdOEY=

# --- JWT développeur (future API mobile/desktop) ---
JWT_SIGNING_KEY=dev-jwt-signing-key-change-me
TOKEN_VALIDITY_WINDOW_SECONDS=300

# --- OAuth social (django-allauth). Laisser vide désactive le bouton correspondant. ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Emails (prod) ---
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@evasee.example
# Adresse de l'équipe qui reçoit le formulaire de contact de la page d'accueil.
# CONTACT_EMAIL=contact@evasee.example

# --- Frontend ---
SDK_CDN_URL=https://cdn.examsdk.local/sdk/v1/examsdk.js
